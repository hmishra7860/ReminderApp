# wnap pknt aqbi rjcp

# --- Database Configuration ---
POSTGRES_DB=remindercal
POSTGRES_USER=rcal
POSTGRES_PASSWORD=rcalpass

# --- Backend Connection String ---
# This ensures local testing (like pytest) and Docker use the exact same DB
DATABASE_URL=postgresql+asyncpg://rcal:rcalpass@postgres:5432/remindercal

# --- Email Notifications ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=you@gmail.com

# --- JWT Security ---
JWT_SECRET=super_secret_dev_key_change_in_prod